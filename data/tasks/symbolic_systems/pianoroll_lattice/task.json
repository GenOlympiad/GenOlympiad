          "args": ["image", "reference.seq_lanes", "reference.n_lanes"],
          "out": "m"
        },
        {
          "fail_if": ["m.no_read"]
        },
        {
          "run": null,
          "expression": "(_prep(image) and list(_SKEW.values()))",
          "code": {
            "inline": "read_roll_code"
          },
          "out": "sk"
        },
        {
          "run": "pr_paint",
          "args": ["m", "sk", "image", "reference.seq_lanes"],
