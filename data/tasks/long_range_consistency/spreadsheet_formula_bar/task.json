        {
          "fail_if": ["cell.no_plan"]
        },
        {
          "read_crop": "This is one cell cut out of a spreadsheet grid. What number is printed inside this cell? Answer with digits only and nothing else. If no number is printed here, answer the single word blank.",
          "boxes": "cell.cells",
          "pad": 0.0,
          "out": "rnum"
        },
        {
          "run": "first_answer_text",
          "args": ["rnum"],
          "out": "raw"
