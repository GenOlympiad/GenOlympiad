        },
        {
          "run": "first_answer_number",
          "args": ["rnum", "{'idx': 0}"],
          "out": "num"
        },
        {
          "compare_tolerance": "num.v",
          "to": 152,
          "tol": 0.5,
          "out": "frac"
        },
        {
          "run": "ag_paint_frac",
          "args": ["cell", "frac"],
          "out": "pa"
        },
        {
          "overlay": "similarity",
          "rects": "pa.hit",
