        {
          "run": "sky_fit",
          "args": [
            "image",
            "reference.n_panels",
            "reference.axis",
            "pb",
            "[r0a, r0b, r0c]",
            "[r1a, r1b, r1c]",
            "[r2a, r2b, r2c]",
            "q0",
            "q1",
            "q2"
