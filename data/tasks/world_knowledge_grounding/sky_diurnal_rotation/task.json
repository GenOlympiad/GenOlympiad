{
  "id": "sky_diurnal_rotation",
  "axis": "world_knowledge_grounding",
  "prompt": "Render a page from a hand-kept observing notebook, southern hemisphere: three circular eyepiece-field sketches of exactly the same size, drawn in a row across the ruled page, with the time written under each circle -- 19:20 under the left circle, 22:00 under the middle circle and 00:40 under the right circle.\n\nAll three circles look at the same patch of sky from the same spot, so all three must show THE SAME five stars. Use an invented practice asterism of five stars -- make up your own arrangement, do not draw a real constellation. Mark the south celestial pole with one small cross, drawn at exactly the same place inside all three circles.\n\nWork out for yourself how far, and which way round, that star pattern has moved between each printed time and the next, and draw the middle and right circles accordingly. The pattern must keep its shape and its size exactly: every star stays exactly as far from the marked cross as it was in the first circle. Do not simply repeat one circle in the next.\n\nEach star is a small solid pencil dot, all five about the same size, with no lines joining them and no labels on them. The three times are the only writing on the page.\n",
  "difficulty": "s3",
  "easy_question": "This image was supposed to show a notebook page carrying THREE circular sketches drawn in a row, each circle holding a scatter of small dots and one small cross-shaped mark, with a time written under it. Ignoring artistic quality and styling, does the image actually show that? Answer NO only if it shows something else entirely -- a blank panel, a page of text, or an unrelated picture. Answer yes or no only.",
  "reference": {
    "vlm_leaves": true,
    "n_panels": 3,
    "axis": "lr",
    "n_stars": 5,
    "steps": [-40.0, -40.0]
  },
  "checks": [
    {
      "name": "scene_compliance",
      "weight": 1.0,
      "gate": true,
      "steps": [
        {
          "ask": "reference.easy_question",
          "out": "sc"
        },
        {
          "fail_if": ["sc.unreadable"]
        },
        {
          "compare": "sc",
          "to": "yes",
          "out": "frac"
        }
      ]
    },
    {
      "name": "same_star_field_in_every_panel",
      "weight": 1.0,
      "gate": true,
      "premise": true,
      "steps": [
        {
          "run": "panel_boxes",
          "args": ["image", "reference.n_panels", "reference.axis"],
          "out": "pb"
        },
        {
          "crop": "pb.p0",
          "out": "c0"
        },
        {
          "crop": "pb.p1",
          "out": "c1"
        },
        {
          "crop": "pb.p2",
          "out": "c2"
        },
        {
          "read": "boxes",
          "image": "c0",
          "target": "small round star dots",
          "expected_n": "reference.n_stars",
          "retries": 4,
          "out": "r0a"
        },
        {
          "read": "boxes",
          "image": "c0",
          "target": "small solid round dots",
          "expected_n": "reference.n_stars",
          "retries": 4,
          "out": "r0b"
        },
        {
          "read": "boxes",
          "image": "c0",
          "target": "small round dots",
          "expected_n": "reference.n_stars",
          "retries": 4,
          "out": "r0c"
        },
        {
          "read": "boxes",
          "image": "c1",
          "target": "small round star dots",
          "expected_n": "reference.n_stars",
          "retries": 4,
          "out": "r1a"
        },
        {
          "read": "boxes",
          "image": "c1",
          "target": "small solid round dots",
          "expected_n": "reference.n_stars",
          "retries": 4,
          "out": "r1b"
