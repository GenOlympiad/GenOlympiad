        {
          "fail_if": ["sb.degenerate"]
        },
        {
          "read_crop": "Reading from LEFT to RIGHT along this narrow strip, name the colour of every coloured band you meet, in order. Answer as a plain comma-separated list of colour words and nothing else.",
          "boxes": "sb",
          "pad": 0.0,
          "out": "cr"
        },
        {
          "fail_if": ["cr.unreadable"]
        },
        {
          "run": "depth_from_words",
          "args": ["cr", "'orange'", "'blue'"],
          "out": "rd"
