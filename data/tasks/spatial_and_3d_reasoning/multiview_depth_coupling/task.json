          "ref_anchors": "ov.ref_anchors",
          "found_anchors": "ov.found_anchors",
          "color": [230, 40, 40],
          "width_frac": 0.004,
          "out": "ovm4"
        },
        {
          "overlay": "homography",
          "image": "ovm4.path",
          "polylines": "ov.mk_want_foot.polylines",
          "ref_anchors": "ov.ref_anchors",
