        {
          "compare_bands": ["vp.width_mismatch", "vp.height_mismatch"],
          "to": 0.0,
          "core": 0.03,
          "margin": 0.08,
          "aggregate": "mean",
          "out": "frac"
        }
      ]
    },
    {
      "name": "d1_panel_overlay",
      "weight": 0.0,
      "only_if": "reference.vlm_leaves",
      "steps": [
        {
          "run": "panel_overlay_marked",
          "args": ["image"],
          "out": "ov"
        },
        {
          "overlay": "homography",
          "image": "ov.path",
          "rects": "ov.mk_panel_front.rects",
          "ref_anchors": "ov.ref_anchors",
